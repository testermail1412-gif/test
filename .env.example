# Ad Studio — Google Veo 3 (Gemini API)
# Copy to ".env" (gitignored) and fill in. NEVER commit real keys.

# Your Gemini API key (from https://aistudio.google.com/apikey).
# Without it, Ad Studio runs in simulation mode.
VITE_GEMINI_API_KEY=

# Optional: override the Veo model (e.g. veo-3.0-fast-generate-preview).
# VITE_VEO_MODEL=veo-3.0-generate-preview

# Optional: server-side proxy for the Gemini API (recommended in production so
# the key never reaches the browser). Defaults to the Vite dev proxy /api/gemini.
# VITE_GEMINI_ENDPOINT=https://your-proxy.example.com/gemini
